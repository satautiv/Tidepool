{
  "name": "tidepool",
  "private": true,
  "version": "0.0.0",
  "description": "A calm, satisfying block puzzle set in a sunlit tidepool.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:web",
    "build:web": "tsc --noEmit && vite build --mode web --outDir dist/web",
    "build:itch": "tsc --noEmit && vite build --mode itch --outDir dist/itch",
    "build:crazygames": "tsc --noEmit && vite build --mode crazygames --outDir dist/crazygames",
    "build:poki": "tsc --noEmit && vite build --mode poki --outDir dist/poki",
    "build:android": "tsc --noEmit && vite build --mode android --outDir dist/android",
    "build:all": "npm run build:web && npm run build:itch && npm run build:crazygames && npm run build:poki && npm run build:android",
    "check:targets": "tsx tools/check-targets.ts",
    "preview": "vite preview --outDir dist/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:dist": "tsx tools/check-dist.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sim": "tsx tools/sim/cli.ts",
    "screenshot": "tsx tools/screenshot.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
